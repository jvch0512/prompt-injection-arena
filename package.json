{
  "name": "prompt-injection-arena",
  "version": "0.1.0",
  "description": "A playable CTF for prompt injection: attack a simulated LLM through 6 levels of defenses, then run the automated red-team lab. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/src/main.js",
    "redteam": "tsc && node dist/src/redteam-cli.js",
    "test": "tsc && node --test dist/test/arena.test.js",
    "lint": "tsc --noEmit"
  },
  "repository": "github:jvch0512/prompt-injection-arena",
  "keywords": ["llm", "prompt-injection", "owasp-llm", "ctf", "ai-security", "typescript"],
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" },
  "engines": { "node": ">=20" }
}
